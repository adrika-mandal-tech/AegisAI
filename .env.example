# AegisAI runtime configuration.
# Copy to backend/.env (the backend reads .env from its working directory):
#   cp .env.example backend/.env
AEGIS_APP_ENV=development
AEGIS_DEBUG=false

# ── LLM providers ──────────────────────────────────────────────────────────
# Provider: "auto" (Gemini primary, Groq fallback), "gemini", "groq", or "openlm"
AEGIS_LLM_PROVIDER=auto
AEGIS_LLM_FALLBACK_PROVIDER=groq

# Gemini: single key, or comma-separated keys for rotation on 429s
AEGIS_GEMINI_API_KEY=
# AEGIS_GEMINI_API_KEYS=key1,key2,key3
# gemini-2.5-flash / 2.0-flash return 404 for new users; 3.5-flash-lite is fastest available
AEGIS_GEMINI_MODEL=gemini-3.5-flash-lite
AEGIS_GEMINI_TIMEOUT_SECONDS=20

# Groq fallback (default model: openai/gpt-oss-120b)
AEGIS_GROQ_API_KEY=
# AEGIS_GROQ_API_KEYS=key1,key2

# Optional OpenLM / OmniRoute OpenAI-compatible LLM gateway (NOT an embedding model)
AEGIS_OPENLM_ENABLED=false
AEGIS_OPENLM_BASE_URL=
AEGIS_OPENLM_API_KEY=
AEGIS_OPENLM_MODEL=openlm-research/open_llama_7b

# ── Embeddings ─────────────────────────────────────────────────────────────
AEGIS_EMBEDDING_PROVIDER=bge-m3
AEGIS_EMBEDDING_MODEL=BAAI/bge-m3
AEGIS_EMBEDDING_DIMENSIONS=1024

# ── Vector store ───────────────────────────────────────────────────────────
# Leave AEGIS_QDRANT_URL EMPTY to use the embedded on-disk store at backend/data/qdrant
# (no Docker needed). Set it to http://localhost:6333 only if you run a Qdrant server.
AEGIS_QDRANT_URL=
AEGIS_QDRANT_API_KEY=
AEGIS_QDRANT_COLLECTION=aegisai
AEGIS_QDRANT_STORAGE_PATH=./data/qdrant

# ── Documents & chunking ───────────────────────────────────────────────────
AEGIS_DOCUMENT_ROOT=./data/documents
AEGIS_DOCUMENT_MAX_BYTES=524288000
AEGIS_CHUNK_SIZE=900
AEGIS_CHUNK_OVERLAP_PERCENT=0.10
AEGIS_CHUNK_STRATEGY=document_aware

# ── Optional integrations ──────────────────────────────────────────────────
AEGIS_TAVILY_API_KEY=
AEGIS_HF_API_KEY=
AEGIS_LANGSMITH_TRACING=false
AEGIS_LANGSMITH_API_KEY=
AEGIS_LANGSMITH_PROJECT=aegisai
AEGIS_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
